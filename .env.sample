# AEVORA environment template — copy to `.env.local` and fill in the values.
# Variable names only; no secrets are committed to the repository.

# ── Frontend (Vite — read at build time) ─────────────────────────────────────
VITE_NEON_API_URL=
VITE_NEON_API_KEY=
VITE_NEON_AUTH_URL=

# ── API (Hono on the Neon Function) ──────────────────────────────────────────
DATABASE_URL=
DATABASE_URL_UNPOOLED=
API_KEY=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# ── Neon Object Storage (S3-compatible) ──────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# ── Neon project metadata ────────────────────────────────────────────────────
NEON_BRANCH=
NEON_FUNCTION_API_BASE_URL=
